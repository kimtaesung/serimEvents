# 가비아 Node.js 컨테이너 환경 설정
NODE_ENV=production
PORT=8007

# 데이터베이스 설정 (가비아 제공 정보로 변경하세요)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=serimrobo
DB_USER=your_gabia_db_user
DB_PASSWORD=your_gabia_db_password

# JWT 설정 (보안상 반드시 변경하세요)
JWT_SECRET=your_production_jwt_secret_change_this_for_security

# 관리자 계정 설정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@serimrobo.com

# API 기본 URL (가비아 도메인으로 변경하세요)
VITE_API_BASE_URL=http://localhost:8007

# 업로드 설정
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 로깅 설정
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 메일 발송 설정 (gmail 또는 hiworks)
MAIL_PROVIDER=gmail

# Gmail SMTP 설정
GMAIL_EMAIL=your_gmail_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_SENDER_EMAIL=admin@events.serimrobotics.co.kr