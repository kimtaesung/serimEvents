NODE_ENV=production
PORT=10000
DB_TYPE=postgres
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=serimrobo
DB_USER=serimrobo_user
DB_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@serimrobo.com

# HTTPS 설정 (Docker/자체 호스팅 환경용)
USE_HTTPS=false

# HTTPS 인증서 경로
CERT_PATH=/app/certs/fullchain.pem
KEY_PATH=/app/certs/privkey.pem

# 하이웍스 카카오 알림톡 API 설정
HIWORKS_OFFICE_TOKEN=your_hiworks_office_token_here
HIWORKS_API_URL=https://api.hiworks.com
KAKAO_TEMPLATE_CODE=your_kakao_template_code_here
KAKAO_SENDER_PHONE=your_sender_phone_number_here
# 카카오 알림톡 전송 활성화 여부 (true: 활성화, false: 비활성화, 기본값: true)
ENABLE_KAKAO_NOTIFICATION=true

# 메일 발송 설정 (하이웍스 또는 Gmail 선택 가능)
# 메일 발송 방식 선택: 'gmail' 또는 'hiworks' (기본값: 'gmail')
MAIL_PROVIDER=gmail

# Gmail SMTP 설정 (MAIL_PROVIDER=gmail 일 때)
GMAIL_EMAIL=your_gmail_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_SENDER_EMAIL=admin@events.serimrobotics.co.kr

# 하이웍스 메일 발송 설정 (MAIL_PROVIDER=hiworks 일 때)
HIWORKS_MAIL_USER_ID=your_hiworks_mail_user_id_here
# 메일 발송 쿨다운 시간 (분 단위, 기본값: 10)
MAIL_SEND_COOLDOWN_MINUTES=10
