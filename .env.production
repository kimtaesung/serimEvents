# 배포 환경 설정

# Node 환경
NODE_ENV=production

# 서버 설정
PORT=8007
API_BASE_URL=https://serimrobo.example.com

# JWT 토큰 비밀 키 (배포 시 변경 필수)
JWT_SECRET=your-production-secret-key-change-this

# 데이터베이스 (배포 환경에서 사용)
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=serimrobo
DB_PORT=3306
