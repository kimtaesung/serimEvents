{
  "name": "serimrobo",
  "version": "1.0.0",
  "description": "serimRobo - React + TypeScript + Express + MySQL SPA",
  "main": "server/index.js",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build --outDir public_html",
    "build:with-types": "tsc && vite build --outDir public_html",
    "preview": "vite preview",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "gabia:build": "npm run build && echo Build completed for Gabia hosting",
    "gabia:deploy": "pm2 start ecosystem.config.js --env production",
    "gabia:stop": "pm2 stop serimrobo-server",
    "gabia:restart": "pm2 restart serimrobo-server",
    "gabia:logs": "pm2 logs serimrobo-server",
    "gabia:monitor": "pm2 monit",
    "gabia:status": "pm2 status",
    "render:init": "node scripts/init-db.js"
  },
  "keywords": [
    "react",
    "typescript",
    "express",
    "mysql",
    "spa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.263.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.8.0",
    "sonner": "^1.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^1.4.7",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.15",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "typescript": "^4.9.3",
    "vite": "^4.5.0"
  }
}
