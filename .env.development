# 개발 환경 설정

# Node 환경
NODE_ENV=development

# 서버 설정
PORT=8007
API_BASE_URL=http://localhost:8007

# 데이터베이스 타입
DB_TYPE=mysql

# JWT 토큰 비밀 키
JWT_SECRET=dev-secret-key-change-in-production

# 데이터베이스 (배포 환경에서 사용)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=serim!123
DB_NAME=serimrobo
DB_PORT=3306

# 메일 발송 설정 (gmail 또는 hiworks)
MAIL_PROVIDER=gmail

# Gmail SMTP 설정
GMAIL_EMAIL=your_gmail_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_SENDER_EMAIL=admin@events.serimrobotics.co.kr
