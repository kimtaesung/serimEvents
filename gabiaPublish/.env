# HTTPS 설정 (Docker/자체 호스팅 환경용)
# 가비아 호스팅은 자체 SSL 제공하므로 false로 설정
USE_HTTPS=false
# HTTPS 인증서 경로 (실제 경로: /web/serim_rending/certs/)
CERT_PATH=.
KEY_PATH=.

# 하이웍스 카카오 알림톡 API 설정
HIWORKS_OFFICE_TOKEN=2e6c7e4230c650d8d09c96e3c79ace07
HIWORKS_API_URL=https://api.hiworks.com
KAKAO_TEMPLATE_CODE=your_kakao_template_code_here
KAKAO_SENDER_PHONE=your_sender_phone_number_here
# 카카오 알림톡 전송 활성화 여부 (true: 활성화, false: 비활성화)
ENABLE_KAKAO_NOTIFICATION=false

# 하이웍스 메일 발송 설정
